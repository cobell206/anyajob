# Anthropic API key — get from console.anthropic.com (separate from your Pro/Max sub)
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxx

# Daily spend cap in USD — script refuses to run if today's spend exceeds this
MAX_DAILY_SPEND=2.00

# Server
PORT=3000

# Logging — see DEPLOY.md "Reading logs" for details
# NOTE: keep values on their own line. systemd's EnvironmentFile does NOT
# strip trailing `# comments`, so `LOG_LEVEL=info  # comment` becomes the
# literal value "info  # comment" and pino crashes at startup.

# 'development' enables pretty colored logs
NODE_ENV=production
# trace | debug | info | warn | error | fatal
LOG_LEVEL=info
# Uncomment to force pretty output in production:
# LOG_FORMAT=pretty

# Optional: USAJobs API (free, register at developer.usajobs.gov)
USAJOBS_EMAIL=your@email.com
USAJOBS_API_KEY=

# Optional: comma-separated Greenhouse board slugs to scrape
# Find via: https://boards.greenhouse.io/<slug>
GREENHOUSE_BOARDS=cravath,davispolk,sullcrom

# Optional: comma-separated Lever company slugs
# Find via: https://jobs.lever.co/<slug>
LEVER_COMPANIES=

# S3 backup destination (used by `npm run backup`)
# AWS credentials are read from ~/.aws/credentials (set up via `aws configure`)
BACKUP_BUCKET=s3://anyajob-backup-<random>/job-tracker

# Email notifications via AWS SES
# 1. Verify your domain in SES, then verify the sender address
# 2. Request production access (out of sandbox) so you can send to any address
# 3. Set NOTIFY_FROM to a verified address on a verified domain
# AWS_REGION default is us-east-1; change if your SES is elsewhere
AWS_REGION=us-east-1
NOTIFY_FROM="AnyaJob <alerts@anyalawgirly.com>"

# Public URL used in email links — should match your Cloudflare hostname
PUBLIC_URL=https://jobs.anyalawgirly.com
